{
  "name": "dsh-plugin-aiboard",
  "version": "0.1.0",
  "description": "Play Avalon on AIBoard with guided account pairing and MCP tools.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "tsc --noEmit",
    "prepack": "npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  }
}
